{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sydney-cartogram",
  "main": "src/worker.js",
  "compatibility_date": "2026-04-13",
  "routes": [
    {
      "pattern": "example.com/sydney*",
      "zone_name": "example.com"
    }
  ],
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
